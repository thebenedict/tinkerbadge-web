	(text "Shared nominal 3.3 V rail"
		(exclude_from_sim no)
		(at 17.78 147.32 0)
		(effects
			(font
				(size 1.52 1.52)
			)
			(justify left bottom)
		)
		(uuid "7c92735e-bcba-4e8e-9605-45691cef27f6")
	)
	(text "CHARGING\nCE tied low: charger enabled, 270 mA (R113), USB500 input limit.\nRT101 10k || RT102 100k NTC under the cell: charge window 1.7-44.8 degC nominal,\n0.1-48.4 degC over the charger's threshold and bias tolerance.\nJ102 is JST-PH, pin 1 = battery +. CHECK PACK POLARITY before connecting.\nUse a protected 1S 4.2 V pack rated for >= 300 mA charge."
		(exclude_from_sim no)
		(at 281.94 246.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "836efdc2-2b63-481c-9a6f-79f966a73ba8")
	)
	(text "Display power"
		(exclude_from_sim no)
		(at 281.94 147.32 0)
		(effects
			(font
				(size 1.52 1.52)
			)
			(justify left bottom)
		)
		(uuid "9fb21c77-faa7-4890-ac14-ded3f5123c96")
	)
	(text "FIRST-PROTOTYPE RAIL EXCEPTION\n56k / 10k: 3.3 V nominal. No LDO.\nPWM static estimate: 3.256 to 3.344 V.\nLED source minimum is 3.3 V.\nLED operation is NOT guaranteed.\nTest startup, low battery, Wi-Fi and\nfull-white steps at the LED pins.\nSee power.md for limits and test gates."
		(exclude_from_sim no)
		(at 20.32 241.3 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left top)
		)
		(uuid "b9d2e1e2-8442-4fca-82fb-b712cef528ab")
	)
	(text "Electrical development draft. No PCB layout or manufacturing release. See docs/design/power.md."
		(exclude_from_sim no)
		(at 15.24 280.67 0)
		(effects
