)
	(text "Prototype electrical capture. Physical FPC mating and panel revision must be verified before layout."
  (at 17.78 20.32 0)
  (effects
    (font
      (size 1.27 1.27)
    )
    (justify left bottom)
  )
  (uuid "61bf8708-4b19-4ee0-aa7e-55ddce0fdb57")
)
	(text "U301 isolates MCU outputs when the panel supply is off (Ioff-rated). BUSY is a pulled-down input."
  (at 17.78 119.38 0)
  (effects
    (font
      (size 1.27 1.27)
    )
    (justify left bottom)
  )
  (uuid "a3cad8d2-92e5-4a39-b0ec-08aa7deccdb9")
)
	(text "Power-on: hold reset low, enable +3V3_EPD, initialize, then update. Quiesce SPI and sleep the panel before power-off."
  (at 17.78 124.46 0)
  (effects
    (font
      (size 1.27 1.27)
    )
    (justify left bottom)
  )
  (uuid "3f1970a9-280e-4bcf-a9bd-19e77368c237")
)
